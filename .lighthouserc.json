{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": ["http://localhost/", "http://localhost/banda-para-missa/", "http://localhost/blog/"],
      "numberOfRuns": 2,
      "settings": {
        "formFactor": "mobile",
        "budgetPath": "./budget.json",
        "blockedUrlPatterns": ["*googletagmanager.com*", "*google-analytics.com*", "*googleads*", "*doubleclick.net*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["error", { "minScore": 0.8 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 40000 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 50000 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 120000 }],
        "resource-summary:third-party:size": ["error", { "maxNumericValue": 0 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 1 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
